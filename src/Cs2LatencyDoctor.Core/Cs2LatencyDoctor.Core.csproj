<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Инструмент только для Windows: реестр, сетевые интерфейсы, powercfg. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Cs2LatencyDoctor.Core</AssemblyName>
    <RootNamespace>Cs2LatencyDoctor.Core</RootNamespace>
  </PropertyGroup>

  <!--
    System.Management нужен только для одной вещи: паспортные частоты монитора
    лежат в EDID, и добраться до них можно лишь через WMI. Все вызовы WMI
    ограничены по времени и обёрнуты в try/catch — недоступная служба WMI
    задержит одну проверку, но не программу.

    Список сетевых адаптеров берётся из встроенного System.Net.NetworkInformation,
    а настройки драйвера — из реестра. Проверка сетевой карты от WMI не зависит.
  -->
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
