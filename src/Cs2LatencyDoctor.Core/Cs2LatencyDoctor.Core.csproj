<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Инструмент только для Windows: реестр, WMI, powercfg. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Cs2LatencyDoctor.Core</AssemblyName>
    <RootNamespace>Cs2LatencyDoctor.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
