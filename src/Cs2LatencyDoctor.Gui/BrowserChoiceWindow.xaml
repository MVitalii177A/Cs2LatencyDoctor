<Window x:Class="Cs2LatencyDoctor.Gui.BrowserChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Открыть ссылку в браузере"
        Height="560" Width="700"
        MinHeight="420" MinWidth="560"
        Background="#14151A"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1C1D23"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B8D98"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Не удалось открыть ссылку автоматически"
                       Foreground="#E6E7EB" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" Margin="0,6,0,0"
                       Text="Обычный способ не сработал: скорее всего, браузер по умолчанию не отвечает. Выберите браузер из списка — программа откроет ссылку им."/>
        </StackPanel>

        <!-- Адрес: его всегда можно скопировать и открыть где угодно -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8"
                Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="АДРЕС" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Скопировать" Padding="12,6"
                            Margin="8,0,0,0" Click="OnCopyUrlClick"
                            Background="#2A2C34" Foreground="#E6E7EB" BorderThickness="0"/>
                    <TextBox x:Name="UrlBox" IsReadOnly="True" Background="#20222A"
                             Foreground="#C9CBD3" BorderThickness="0" Padding="8,6"
                             FontSize="12" TextWrapping="NoWrap" VerticalContentAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="НАЙДЕННЫЕ БРАУЗЕРЫ"
                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                   FontWeight="SemiBold" Margin="0,0,0,8"/>

        <!-- Список браузеров -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#20222A" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Открыть здесь"
                                            Padding="12,6" Margin="10,0,0,0"
                                            Tag="{Binding}" Click="OnOpenHereClick"
                                            Background="#2A2C34" Foreground="#E6E7EB"
                                            BorderThickness="0"/>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="#E6E7EB"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Path}" Foreground="#6E6E77"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Result}" Foreground="#30A46C"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Низ -->
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="#6E6E77" FontSize="11"
                       Text="Если ни один браузер не открылся, скопируйте адрес кнопкой выше и вставьте его в браузер вручную. Программа не может починить сломанный браузер — это вне её возможностей."/>
            <Button Content="Закрыть" HorizontalAlignment="Right" Padding="18,8"
                    Margin="0,12,0,0" Click="OnCloseClick"
                    Background="#2A2C34" Foreground="#E6E7EB" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
