<Window x:Class="Cs2LatencyDoctor.Gui.DonationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поблагодарить разработчиков"
        Height="560" Width="500"
        MinHeight="480" MinWidth="440"
        Background="#14151A"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1C1D23"/>
        <SolidColorBrush x:Key="LineBrush" Color="#2A2C34"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E6E7EB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B8D98"/>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E7EB"/>
            <Setter Property="Background" Value="#2A2C34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#353845"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Поблагодарить разработчиков" Foreground="{StaticResource TextBrush}"
                       FontSize="19" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Margin="0,6,0,0"
                       Text="Программа бесплатная и с открытым кодом. Платить ничего не нужно — все проверки и исправления работают полностью. Если она вам помогла и есть желание поддержать разработку, вот реквизиты."/>
        </StackPanel>

        <!-- Содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- USDT -->
                <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="USDT — криптовалюта" Style="{StaticResource SectionTitle}"/>

                        <TextBlock x:Name="UsdtNetworkText" Foreground="#C9CBD3" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <!-- QR-код из готовой картинки -->
                        <Border x:Name="QrFrame" Background="White" CornerRadius="8" Padding="10"
                                HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Image x:Name="QrImage" Width="180" Height="180"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>

                        <TextBlock x:Name="QrMissingText" Foreground="#F5A524" FontSize="11"
                                   TextWrapping="Wrap" HorizontalAlignment="Center"
                                   Margin="0,0,0,10" Visibility="Collapsed"/>

                        <TextBlock Text="Адрес кошелька:" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" Margin="0,0,0,4"/>

                        <Border Background="#20222A" CornerRadius="6" Padding="4">
                            <TextBox x:Name="AddressText" IsReadOnly="True" BorderThickness="0"
                                     Background="Transparent" Foreground="#E6E7EB"
                                     FontSize="12" FontFamily="Consolas" Padding="8"
                                     TextWrapping="Wrap"/>
                        </Border>

                        <Button x:Name="CopyAddressButton" Content="Скопировать адрес"
                                Style="{StaticResource BaseButton}" Margin="0,10,0,0"
                                Click="OnCopyAddressClick"/>

                        <TextBlock Text="Проверьте сеть перед переводом: адрес одной сети не подходит для другой. Отправка не в ту сеть означает потерю средств."
                                   Foreground="#8B8D98" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- DonationAlerts -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="DonationAlerts — картой или из кошелька"
                                   Style="{StaticResource SectionTitle}"/>

                        <TextBlock TextWrapping="Wrap" Foreground="#C9CBD3" FontSize="12"
                                   Text="Откроется страница в браузере: можно поддержать разово или подписаться. Работает с российскими картами."/>

                        <Button x:Name="DonationAlertsButton" Content="Открыть DonationAlerts"
                                Style="{StaticResource BaseButton}" Margin="0,12,0,0"
                                Click="OnDonationAlertsClick"/>

                        <TextBlock x:Name="DonationAlertsMissingText" Foreground="#F5A524"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Низ -->
        <Border Grid.Row="2" Margin="0,14,0,0" Background="#1C1D23" CornerRadius="8" Padding="12,10">
            <StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#30A46C" FontSize="12" TextWrapping="Wrap"/>
                <Button Content="Закрыть" Style="{StaticResource BaseButton}"
                        HorizontalAlignment="Right" Margin="0,10,0,0" Click="OnCloseClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
