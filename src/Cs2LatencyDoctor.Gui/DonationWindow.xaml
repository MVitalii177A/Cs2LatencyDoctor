<Window x:Class="Cs2LatencyDoctor.Gui.DonationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cs2LatencyDoctor.Gui"
        Title="Поблагодарить разработчиков"
        Height="620" Width="520"
        MinHeight="480" MinWidth="440"
        Background="#14151A"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1C1D23"/>
        <SolidColorBrush x:Key="LineBrush" Color="#2A2C34"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E6E7EB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B8D98"/>

        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E7EB"/>
            <Setter Property="Background" Value="#2A2C34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#353845"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Поблагодарить разработчиков" Foreground="{StaticResource TextBrush}"
                       FontSize="19" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Margin="0,6,0,0"
                       Text="Программа бесплатная и с открытым кодом. Платить ничего не нужно — все проверки и исправления работают полностью. Если она вам помогла и есть желание поддержать разработку, вот реквизиты."/>
        </StackPanel>

        <!-- Кошельки и DonationAlerts -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="WalletList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding NetworkText}" Foreground="#C9CBD3"
                                               FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Note}" Foreground="#6E6E77"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>

                                    <!-- QR-код из готовой картинки -->
                                    <Border Background="White" CornerRadius="8" Padding="10"
                                            HorizontalAlignment="Center" Margin="0,12,0,10"
                                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                                        <Image Source="{Binding QrImage}" Width="180" Height="180"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>

                                    <TextBlock Text="{Binding ImageProblem}" Foreground="#F5A524" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,8,0,8"
                                               Visibility="{Binding HasImageProblem, Converter={StaticResource BoolToVisibility}}"/>

                                    <TextBlock Text="Адрес кошелька:" Foreground="{StaticResource MutedBrush}"
                                               FontSize="11" Margin="0,0,0,4"/>

                                    <Border Background="#20222A" CornerRadius="6" Padding="4">
                                        <TextBox Text="{Binding Address, Mode=OneWay}" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="#E6E7EB" FontSize="12"
                                                 FontFamily="Consolas" Padding="8" TextWrapping="Wrap"/>
                                    </Border>

                                    <Button Content="Скопировать адрес" Style="{StaticResource BaseButton}"
                                            Margin="0,10,0,0" Tag="{Binding Address}"
                                            IsEnabled="{Binding HasAddress}"
                                            Click="OnCopyAddressClick"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- DonationAlerts -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="DonationAlerts — картой или из кошелька"
                                   Style="{StaticResource SectionTitle}"/>

                        <TextBlock TextWrapping="Wrap" Foreground="#C9CBD3" FontSize="12"
                                   Text="Откроется страница в браузере: можно поддержать разово или подписаться."/>

                        <Button x:Name="DonationAlertsButton" Content="Открыть DonationAlerts"
                                Style="{StaticResource BaseButton}" Margin="0,12,0,0"
                                Click="OnDonationAlertsClick"/>

                        <TextBlock x:Name="DonationAlertsMissingText" Foreground="#F5A524"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Проверьте сеть перед переводом: адрес одной сети не подходит для другой. Отправка не в ту сеть означает потерю средств."
                           Foreground="#8B8D98" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Низ -->
        <Border Grid.Row="2" Margin="0,14,0,0" Background="#1C1D23" CornerRadius="8" Padding="12,10">
            <StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#30A46C" FontSize="12" TextWrapping="Wrap"/>
                <Button Content="Закрыть" Style="{StaticResource BaseButton}"
                        HorizontalAlignment="Right" Margin="0,10,0,0" Click="OnCloseClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
