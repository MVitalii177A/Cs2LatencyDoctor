<Window x:Class="Cs2LatencyDoctor.Gui.DonationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cs2LatencyDoctor.Gui"
        Title="Поблагодарить разработчиков"
        Height="740" Width="940"
        MinHeight="560" MinWidth="640"
        Background="#14151A"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1C1D23"/>
        <SolidColorBrush x:Key="LineBrush" Color="#2A2C34"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2EA043"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E6E7EB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B8D98"/>

        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E7EB"/>
            <Setter Property="Background" Value="#2A2C34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#353845"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Поблагодарить разработчиков" Foreground="{StaticResource TextBrush}"
                       FontSize="19" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Margin="0,6,0,0"
                       Text="Программа бесплатная и с открытым кодом. Платить ничего не нужно — все проверки и исправления работают полностью. Если она вам помогла и есть желание поддержать разработку, выберите удобный вариант."/>
        </StackPanel>

        <!-- Кошельки: карточки в ряд, при узком окне переносятся на новую строку -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!--
              Отступ вокруг содержимого не декоративный. Свечение карточки
              расходится за её края, и без запаса по краям его срезает граница
              ScrollViewer — у крайних карточек ореол обрубался. Запас 22 px
              с каждой стороны подобран под размытие свечения.

              Из-за этого запаса карточки пришлось сделать уже: 232 вместо 262,
              чтобы три по-прежнему вставали в один ряд при окне 940.
            -->
            <StackPanel Margin="22,10,22,10">
                <ItemsControl x:Name="WalletList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                              Карточка стоит по ЦЕНТРУ ячейки, ячейка отведена по размеру
                              увеличенной карточки. Поэтому рост идёт во все стороны от
                              центра и не сдвигает соседей.

                              Растёт карточка ЦЕЛИКОМ — вместе с содержимым. Для этого
                              масштаб применяется к самой карточке, а свечение вынесено
                              на отдельную подложку под ней.

                              Почему свечение не на карточке: WPF считает эффект до
                              применения масштаба. Если эффект и масштаб на одном элементе,
                              ореол обрезается по исходному размеру — это мы уже проходили.
                              Подложка не масштабируется, поэтому её эффект считается по
                              фактическим границам и остаётся целым.
                            -->
                            <Canvas Width="262" Height="568" Margin="1,6" ClipToBounds="False">
                                <Grid Width="262" Height="568" ClipToBounds="False">
                                    <!-- Подложка: только свечение, сама ничего не рисует. -->
                                    <Border x:Name="CardGlowHost"
                                            Width="232" Height="510"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="Transparent" ClipToBounds="False">
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="CardGlow"
                                                              Color="#FF8A24"
                                                              BlurRadius="0"
                                                              ShadowDepth="0"
                                                              Opacity="0"
                                                              Direction="270"/>
                                        </Border.Effect>
                                    </Border>

                                    <Border Style="{StaticResource Panel}"
                                            Width="232" Height="510"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            ClipToBounds="False"
                                            MouseEnter="OnCardMouseEnter"
                                            MouseLeave="OnCardMouseLeave">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>

                                        <StackPanel VerticalAlignment="Top">
                                        <!--
                                          VerticalAlignment="Top" обязателен: без него
                                          StackPanel растягивается по высоте карточки и
                                          распределяет лишнее место между элементами.
                                          При росте карточки они разъезжались, и казалось,
                                          что увеличиваются отдельные элементы, а не карточка.
                                        -->

                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding NetworkText}" Foreground="#C9CBD3"
                                               FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Note}" Foreground="#6E6E77"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                               MinHeight="30"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>

                                    <TextBlock Text="{Binding ImageProblem}" Foreground="#F5A524" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,8,0,8"
                                               Visibility="{Binding HasImageProblem, Converter={StaticResource BoolToVisibility}}"/>

                                    <!--
                                      QR-код. При наведении растёт вся карточка вместе
                                      с рамкой, поэтому пропорции сохраняются.
                                    -->
                                    <Border Background="White" CornerRadius="10" Padding="8"
                                            HorizontalAlignment="Center" Margin="0,8,0,0"
                                            Cursor="Hand"
                                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                                        <Image Source="{Binding QrImage}" Width="176" Height="176"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>

                                    <TextBlock Text="Наведите телефон на код" Foreground="#8B8D98"
                                               FontSize="11" HorizontalAlignment="Center"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}"/>

                                    <TextBlock Text="Адрес кошелька:" Foreground="{StaticResource MutedBrush}"
                                               FontSize="11" Margin="0,10,0,4"
                                               Visibility="{Binding HasAddress, Converter={StaticResource BoolToVisibility}}"/>

                                    <Border Background="#20222A" CornerRadius="6" Padding="4"
                                            Visibility="{Binding HasAddress, Converter={StaticResource BoolToVisibility}}">
                                        <!-- Моноширинный шрифт: в адресах важно различать
                                             похожие символы (0 и O, 1 и l, 5 и S). -->
                                        <TextBox Text="{Binding Address, Mode=OneWay}" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="#E6E7EB" FontSize="12"
                                                 FontFamily="Consolas" Padding="8"
                                                 TextWrapping="Wrap" MaxHeight="72"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </Border>

                                    <Button Content="Скопировать адрес" Style="{StaticResource BaseButton}"
                                            Margin="0,10,0,0" Tag="{Binding Address}"
                                            IsEnabled="{Binding HasAddress}"
                                            Click="OnCopyAddressClick"
                                            Visibility="{Binding HasAddress, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- DonationAlerts -->
                <Border Style="{StaticResource Panel}" Margin="6,6,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="DonationAlerts — картой или из кошелька"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#C9CBD3" FontSize="12"
                                       Text="Наведите телефон на код или откройте страницу в браузере. Поддержать можно разово или подпиской."/>
                            <TextBlock x:Name="DonationAlertsMissingText" Foreground="#F5A524"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="Collapsed"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="DonationAlertsButton" Content="Открыть в браузере"
                                        Style="{StaticResource BaseButton}" MinWidth="170"
                                        Click="OnDonationAlertsClick"/>
                                <Button x:Name="CopyLinkButton" Content="Скопировать ссылку"
                                        Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                                        Click="OnCopyLinkClick"/>
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="DonationAlertsQrFrame" Grid.Column="1" Background="White"
                                CornerRadius="8" Padding="5" VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <Image x:Name="DonationAlertsQrImage" Width="104" Height="104"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="Проверьте сеть перед переводом: адрес одной сети не подходит для другой. Отправка не в ту сеть означает потерю средств."
                           Foreground="#8B8D98" FontSize="11" TextWrapping="Wrap" Margin="6,12,6,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Низ -->
        <Border Grid.Row="2" Margin="0,14,0,0" Background="#1C1D23" CornerRadius="8" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#30A46C" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="Закрыть" Style="{StaticResource BaseButton}"
                        Click="OnCloseClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
