<Window x:Class="Cs2LatencyDoctor.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cs2LatencyDoctor.Gui"
        Title="Cs2LatencyDoctor — что мешает играть в CS2"
        Height="760" Width="1100"
        MinHeight="600" MinWidth="920"
        Background="#14151A"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1C1D23"/>
        <SolidColorBrush x:Key="LineBrush" Color="#2A2C34"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E6E7EB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B8D98"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>

        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E7EB"/>
            <Setter Property="Background" Value="#2A2C34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#353845"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#2F6FEB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Cs2LatencyDoctor" Foreground="{StaticResource TextBrush}"
                       FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Находит причины задержек в CS2 и доказывает результат замерами. Данные не покидают компьютер."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding AdminText}" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="Проверить компьютер" Style="{StaticResource PrimaryButton}"
                    Click="OnCheckClick" IsEnabled="{Binding IsIdle}"/>
            <Button Content="Применить исправления" Style="{StaticResource BaseButton}"
                    Margin="8,0,0,0" Click="OnApplyClick" IsEnabled="{Binding IsIdle}"/>
            <Button Content="Откатить изменения" Style="{StaticResource BaseButton}"
                    Margin="8,0,0,0" Click="OnRevertClick" IsEnabled="{Binding IsIdle}"/>
            <Button Content="Перезапустить от администратора" Style="{StaticResource BaseButton}"
                    Margin="8,0,0,0" Click="OnElevateClick"/>

            <TextBlock Text="Замер, сек:" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Margin="18,0,6,0" FontSize="12"/>
            <TextBox Text="{Binding ProbeSeconds}" Width="48" Background="#2A2C34"
                     Foreground="#E6E7EB" BorderThickness="0" Padding="8,6"
                     FontSize="13" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Основная область -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!-- Находки -->
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="НАХОДКИ" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#20222A" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{Binding Color}" CornerRadius="3"
                                                        Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Mark}" Foreground="White"
                                                               FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" Foreground="#E6E7EB"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Foreground="#C9CBD3"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding Why}" Foreground="#8B8D98"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasWhy, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Text="{Binding FixHint}" Foreground="#4C8DFF"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Правая колонка -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ИСТОРИЯ ЗАМЕРОВ" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding HistoryText}" Foreground="#C9CBD3"
                                   FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="Хранится только на этом компьютере."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="ФОНОВЫЕ ПРОГРАММЫ" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Отметьте то, что не нужно во время матча. Рабочие и системные программы защищены от остановки."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Поставить на паузу" Style="{StaticResource BaseButton}"
                                    Click="OnPauseClick"/>
                            <Button Content="Вернуть обратно" Style="{StaticResource BaseButton}"
                                    Margin="8,0,0,0" Click="OnResumeClick" Background="#24402C"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BackgroundApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#20222A" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                            <StackPanel>
                                                <CheckBox Content="{Binding Title}" IsChecked="{Binding Selected}"
                                                          Foreground="#E6E7EB" FontSize="12"/>
                                                <TextBlock Text="{Binding Details}" Foreground="#8B8D98"
                                                           FontSize="11" Margin="22,3,0,0"/>
                                                <TextBlock Text="{Binding Reason}" Foreground="#6E6E77"
                                                           FontSize="11" TextWrapping="Wrap" Margin="22,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="ЧТО ПРОИЗОШЛО" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding ApplyResult}" Foreground="#C9CBD3"
                                   FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding BackgroundResult}" Foreground="#C9CBD3"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Строка состояния -->
        <Border Grid.Row="3" Margin="0,14,0,0" Background="#1C1D23" CornerRadius="8" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="120" Height="4" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                             Foreground="{StaticResource AccentBrush}" Background="#2A2C34"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
