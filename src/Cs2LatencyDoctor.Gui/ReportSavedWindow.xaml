<Window x:Class="Cs2LatencyDoctor.Gui.ReportSavedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёт сохранён"
        Height="360" Width="640"
        MinHeight="300" MinWidth="480"
        Background="#14151A"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1C1D23"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B8D98"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Отчёт сохранён" Foreground="#30A46C"
                       FontSize="16" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" Margin="0,6,0,0"
                       Text="Файл лежит на вашем компьютере. Программа его никуда не отправляет — отправляете вы сами, если захотите."/>
        </StackPanel>

        <!-- Путь: главное, что нужно человеку -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8"
                Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="ГДЕ ЛЕЖИТ ФАЙЛ" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Скопировать путь"
                            Padding="12,6" Margin="8,0,0,0"
                            Click="OnCopyPathClick"
                            Background="#2A2C34" Foreground="#E6E7EB" BorderThickness="0"/>

                    <TextBox x:Name="PathBox" IsReadOnly="True" Background="#20222A"
                             Foreground="#C9CBD3" BorderThickness="0" Padding="8,6"
                             FontSize="12" TextWrapping="Wrap" MaxHeight="60"
                             VerticalScrollBarVisibility="Auto"
                             GotFocus="OnPathBoxGotFocus"/>
                </DockPanel>

                <TextBlock x:Name="CopiedText" Foreground="#30A46C" FontSize="11"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Что в отчёте: показывается только для подробного -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ExtraText" Foreground="#C9CBD3" FontSize="11"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" TextWrapping="Wrap" Foreground="#6E6E77" FontSize="11"
                   Margin="0,12,0,0"
                   Text="Чтобы найти файл самим: откройте папку с программой, затем папку «отчёты». Или скопируйте путь кнопкой выше и вставьте его в адресную строку проводника."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Открыть папку" Padding="16,8" Click="OnOpenFolderClick"
                    Background="#2A2C34" Foreground="#E6E7EB" BorderThickness="0"/>
            <Button Content="Закрыть" Padding="18,8" Margin="8,0,0,0"
                    Click="OnCloseClick"
                    Background="#2A2C34" Foreground="#E6E7EB" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
