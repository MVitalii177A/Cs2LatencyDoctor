<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NetWatch — наблюдение за сетью и роутером.

    Зачем отдельная программа, а не скрипт. Скрипт зависит от политики запуска
    PowerShell, легко ломается от чужого вмешательства и неудобен человеку.
    Отдельный файл запускается двойным щелчком и работает одинаково везде.

    Про сборку одним файлом. Настройки автономности стоят в условии на сборку
    для выпуска, а не в общих свойствах. Иначе обычная сборка тоже становится
    автономной, и на неё нельзя ссылаться из других проектов — а это нужно
    для проверок.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>netwatch</AssemblyName>
    <RootNamespace>Cs2LatencyDoctor.NetWatch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <!--
    Кодировка консоли (CP866) подключается вызовом CodePagesEncodingProvider
    в коде. Отдельный пакет не нужен: в .NET 10 он уже входит в состав.
  -->

  <!-- Только для выпуска: один файл, который работает без установки .NET -->
  <PropertyGroup Condition="'$(NetWatchRelease)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
